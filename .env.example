# Vartul AI assistants (M7). Optional: with no key the sponsor and verifier assistants run in a
# labelled scripted mode that uses the same gateway tools. The server reads the process environment.
# OpenRouter (or any gateway that speaks the Anthropic Messages API at <base>/v1/messages):
# OPENROUTER_API_KEY=
# VARTUL_AI_MODEL=anthropic/claude-opus-5.5     # use the model slug your gateway lists
# Direct Anthropic API (defaults to claude-opus-5-5 with server-side refusal fallback):
# ANTHROPIC_API_KEY=
# VARTUL_AI_BASE_URL=                            # override the gateway base URL
# VARTUL_AI_DISABLE=1                            # force scripted mode

# Sponsorship application: no .env file or credentials are required.
# Set optional overrides in the process environment before running demo:run.
# The application does not automatically load this file.
DEMO_PORT=4300
DEMO_DISCOVERY_PORT=4301
# The owned application chain uses fixed port 18545 and chain ID 31337.

# Optional Docker integration workbench only; not used by the current app.
# Docker Compose reads these values if copied to .env.
POSTGRES_DB=finternet_poc
POSTGRES_USER=finternet
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
S3_ACCESS_KEY=finternet
S3_SECRET_KEY=change-me-use-at-least-eight-characters
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CHAIN_ID=31337
ETHEREUM_RPC_PORT=8545
IPFS_API_PORT=5001
IPFS_GATEWAY_PORT=8080
