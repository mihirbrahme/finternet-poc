# Vartul reads these from the process environment; no .env file is loaded and none is required.

# Server
# VARTUL_PORT=4300
# VARTUL_CHAIN_PORT=18545                        # local Anvil ledger
# VARTUL_PUBLIC_URL=http://127.0.0.1:4300        # base for verification links and QR codes

# AI assistants (optional). With no key, the sponsor and verifier assistants run in a labelled
# scripted mode that uses the same gateway tools.
# OpenRouter, or any gateway that speaks the Anthropic Messages API at <base>/v1/messages:
# OPENROUTER_API_KEY=
# VARTUL_AI_MODEL=anthropic/claude-opus-5.5     # use the model slug your gateway lists
# Direct Anthropic API (defaults to claude-opus-5-5 with server-side refusal fallback):
# ANTHROPIC_API_KEY=
# VARTUL_AI_BASE_URL=                            # override the gateway base URL
# VARTUL_AI_DISABLE=1                            # force scripted mode

# Public test-network deployment (pnpm testnet deploy only; not used by the demonstration)
# VARTUL_TESTNET_RPC_URL=
# VARTUL_DEPLOYER_KEY=
# VARTUL_ISSUER_ADDRESS=                         # sandbox money issuer; defaults to the deployer
