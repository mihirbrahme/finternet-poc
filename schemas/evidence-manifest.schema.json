{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finternet-poc.local/schemas/evidence-manifest.schema.json",
  "title": "Finternet Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "assetId",
    "evidence",
    "createdAt",
    "manifestHashAlgorithm",
    "manifestHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^EVM-[0-9]{6}$"
    },
    "assetId": {
      "type": "string",
      "pattern": "^RWA-[A-Z0-9]{3}-[0-9]{4}-[0-9]{6}$"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://finternet-poc.local/schemas/evidence.schema.json"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "manifestHashAlgorithm": {
      "const": "SHA-256-CANONICAL-JSON"
    },
    "manifestHash": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "dependencyMode": {
      "type": "string",
      "enum": ["LOCAL_MOCK", "SANDBOX_ADAPTER", "TESTNET_REAL", "PRODUCTION_LIKE", "NOT_CONNECTED"]
    }
  }
}
